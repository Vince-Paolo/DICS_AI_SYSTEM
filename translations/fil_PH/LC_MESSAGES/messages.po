#: app.py:468 templates/pages/error_404.html:3 templates/pages/error_404.html:6
msgid "Page Not Found"
msgstr "Hindi Nahanap ang Pahina"

#: app.py:469
msgid ""
"The link may be outdated or the page may have moved. Please check the URL"
" or return to the dashboard."
msgstr ""
"Maaaring luma na ang link o nailipat ang pahina. Suriin ang URL o bumalik"
" sa dashboard."

#: app.py:480
msgid "Access Denied"
msgstr "Walang Pahintulot"

#: app.py:481
msgid "You don't have permission to view this page or complete that action."
msgstr ""
"Wala kang pahintulot na tingnan ang pahinang ito o isagawa ang pagkilos "
"na iyon."

#: app.py:492
msgid "Too Many Requests"
msgstr "Napakaraming Kahilingan"

#: app.py:493
msgid ""
"This action has been requested too many times. Please wait a moment and "
"try again."
msgstr ""
"Masyadong maraming beses hiniling ang pagkilos na ito. Maghintay sandali "
"at subukang muli."

#: app.py:504
msgid "Your Session Expired"
msgstr "Nag-expire ang Iyong Session"

#: app.py:505
msgid ""
"Your session expired or the form is no longer valid. Please refresh the "
"page and try again."
msgstr ""
"Nag-expire ang iyong session o hindi na wasto ang form. I-refresh ang "
"pahina at subukang muli."

#: app.py:516
msgid "Something Went Wrong"
msgstr "Nagkaroon ng Problema"

#: app.py:517 templates/pages/error_500.html:13
msgid ""
"The system hit an unexpected issue while processing your request. Please "
"try again shortly, or return to the dashboard."
msgstr ""
"Nagkaroon ng hindi inaasahang problema habang pinoproseso ang iyong "
"kahilingan. Subukang muli pagkalipas ng ilang sandali o bumalik sa "
"dashboard."

#: app.py:979
#, python-format
msgid "Welcome back, %(username)s!"
msgstr "Maligayang pagbabalik, %(username)s!"

#: app.py:1038
msgid "Unable to create account. Please try again."
msgstr "Hindi makagawa ng account. Pakisubukang muli."

#: app.py:1040
msgid "Registration successful! You can now log in."
msgstr "Matagumpay ang pagpaparehistro! Maaari ka nang mag-log in."

#: app.py:1110
msgid "If an account exists for that email, a reset link has been sent."
msgstr ""
"Kung may account para sa email na iyon, naipadala na ang link para "
"magtakda muli ng password."

#: app.py:1121
msgid "This password reset link is invalid or has expired."
msgstr "Di-wasto o paso na ang link para magtakda muli ng password."

#: app.py:1142 app.py:1194
msgid "Unable to update password. Please try again."
msgstr "Hindi ma-update ang password. Pakisubukang muli."

#: app.py:1144
msgid "Password updated successfully. Please sign in with your new password."
msgstr ""
"Matagumpay na na-update ang password. Mag-sign in gamit ang bago mong "
"password."

#: app.py:1153
msgid "You have been logged out."
msgstr "Nakapag-sign out ka na."

#: app.py:1197
msgid "Password updated successfully."
msgstr "Matagumpay na na-update ang password."

#: app.py:1840
msgid ""
"You do not have permission to access analytics. Only admins, "
"coordinators, commanders, and EOC staff can view system analytics."
msgstr ""
"Wala kang pahintulot na buksan ang analytics. Admin, coordinator, "
"commander, at kawani ng EOC lamang ang maaaring tumingin sa analytics ng "
"system."

#: app.py:1861
msgid "You do not have permission to view the hazard map."
msgstr "Wala kang pahintulot na tingnan ang mapa ng panganib."

#: app.py:1878
msgid ""
"You do not have permission to access the Incident Command System. Only "
"admins and incident commanders can view this."
msgstr ""
"Wala kang pahintulot na buksan ang Incident Command System. Admin at "
"incident commander lamang ang maaaring tumingin nito."

#: app.py:1890
msgid ""
"You do not have permission to access ICS protocols. Only admins and "
"incident commanders can view this."
msgstr ""
"Wala kang pahintulot na buksan ang mga protocol ng ICS. Admin at incident"
" commander lamang ang maaaring tumingin nito."

#: blueprints/admin.py:60 blueprints/admin.py:108 blueprints/admin.py:121
#: blueprints/admin.py:188 blueprints/admin.py:236 blueprints/admin.py:302
msgid "Admin access required."
msgstr "Kailangan ng pahintulot ng admin."

#: blueprints/admin.py:68 blueprints/admin.py:269 blueprints/eoc.py:199
#: blueprints/eoc.py:232 blueprints/eoc.py:317 blueprints/eoc.py:376
msgid "EOC staff access required."
msgstr "Kailangan ng pahintulot ng kawani ng EOC."

#: blueprints/admin.py:83
msgid "You do not have permission to view all incidents."
msgstr "Wala kang pahintulot na tingnan ang lahat ng insidente."

#: blueprints/admin.py:97
msgid "You do not have permission to view all alerts."
msgstr "Wala kang pahintulot na tingnan ang lahat ng alerto."

#: blueprints/admin.py:134
msgid "Username, email, and password are required."
msgstr "Kailangan ang username, email, at password."

#: blueprints/admin.py:138
msgid "Password must be at least 8 characters."
msgstr "Dapat ay hindi bababa sa 8 character ang password."

#: blueprints/admin.py:142
msgid "Username already exists."
msgstr "May gumagamit na ng username na ito."

#: blueprints/admin.py:146
msgid "Email already registered."
msgstr "Nakarehistro na ang email na ito."

#: blueprints/admin.py:152 blueprints/admin.py:206
msgid ""
"An agency must be selected for this role, or tasks/resources assigned to "
"it will never reach this user."
msgstr ""
"Dapat pumili ng ahensya para sa role na ito; kung hindi, hindi "
"matatanggap ng user na ito ang mga task o resource na itatalaga rito."

#: blueprints/admin.py:155 blueprints/admin.py:209 blueprints/commander.py:591
#, python-format
msgid "Invalid agency \"%(agency)s\". Please select from the list."
msgstr "Di-wasto ang ahensyang \"%(agency)s\". Pumili mula sa listahan."

#: blueprints/admin.py:174 blueprints/admin.py:179
msgid "Unable to create user. Please try again."
msgstr "Hindi makagawa ng user. Pakisubukang muli."

#: blueprints/admin.py:176
#, python-format
msgid "User \"%(username)s\" created successfully."
msgstr "Matagumpay na nagawa ang user na \"%(username)s\"."

#: blueprints/admin.py:197
msgid "Cannot remove last admin account."
msgstr "Hindi maaaring alisin ang huling admin account."

#: blueprints/admin.py:222 blueprints/admin.py:227
msgid "Unable to update user. Please try again."
msgstr "Hindi ma-update ang user. Pakisubukang muli."

#: blueprints/admin.py:224
#, python-format
msgid "User \"%(username)s\" updated successfully."
msgstr "Matagumpay na na-update ang user na \"%(username)s\"."

#: blueprints/admin.py:245
msgid "Cannot disable last active admin account."
msgstr "Hindi maaaring i-disable ang huling aktibong admin account."

#: blueprints/admin.py:254 blueprints/admin.py:260
msgid "Unable to update user status. Please try again."
msgstr "Hindi ma-update ang status ng user. Pakisubukang muli."

#: blueprints/admin.py:257
#, python-format
msgid "Status updated for user \"%(username)s\"."
msgstr "Matagumpay na na-update ang status ng user na \"%(username)s\"."

#: blueprints/admin.py:311
msgid "Password verification failed. Backup export denied."
msgstr ""
"Nabigo ang pag-verify ng password. Hindi pinahintulutan ang pag-export ng"
" backup."

#: blueprints/admin.py:373
msgid "Backup could not be created. Please try again."
msgstr "Hindi magawa ang backup. Pakisubukang muli."

#: blueprints/ai.py:39
msgid ""
"You do not have permission to run hazard predictions. Only incident "
"commanders, EOC staff, and coordinators can perform this action."
msgstr ""
"Wala kang pahintulot na magpatakbo ng hula sa panganib. Incident "
"commander, kawani ng EOC, at coordinator lamang ang maaaring gumawa nito."

#: blueprints/ai.py:115
msgid "Unable to save the AI prediction. Please try again."
msgstr "Hindi ma-save ang hula ng AI. Pakisubukang muli."

#: blueprints/citizen.py:149
msgid ""
"The online incident report form is no longer used. Please call an "
"emergency hotline instead."
msgstr ""
"Hindi na ginagamit ang online na form ng ulat ng insidente. Mangyaring "
"tumawag na lang sa emergency hotline."

#: blueprints/citizen.py:187
msgid "Selected municipality does not match the selected province."
msgstr "Hindi tumutugma ang napiling munisipalidad sa napiling lalawigan."

#: blueprints/citizen.py:192
msgid "Selected barangay does not match the selected municipality."
msgstr "Hindi tumutugma ang napiling barangay sa napiling munisipalidad."

#: blueprints/citizen.py:200 blueprints/citizen.py:206
msgid "Photo upload was invalid."
msgstr "Di-wasto ang na-upload na larawan."

#: blueprints/citizen.py:221
msgid ""
"GPS coordinates are required. Please allow browser location access or "
"place the pin on the map before submitting."
msgstr ""
"Kailangan ang mga GPS coordinate. Payagan ang browser na gamitin ang "
"iyong lokasyon o maglagay ng pin sa mapa bago magsumite."

#: blueprints/citizen.py:269 blueprints/citizen.py:324
msgid "Unable to save your report. Please try again."
msgstr "Hindi ma-save ang iyong ulat. Pakisubukang muli."

#: blueprints/citizen.py:272
msgid ""
"A similar report for this barangay was submitted recently. Your report "
"has been recorded, but no duplicate incident was created."
msgstr ""
"May kahalintulad na ulat para sa barangay na ito kamakailan. Naitala ang "
"iyong ulat, ngunit walang ginawang dobleng insidente."

#: blueprints/citizen.py:326
msgid "Incident report submitted successfully. Authorities have been notified."
msgstr ""
"Matagumpay na naisumite ang ulat ng insidente. Naabisuhan na ang mga "
"awtoridad."

#: blueprints/citizen.py:330
msgid "Unable to submit your report. Please try again."
msgstr "Hindi maisumite ang iyong ulat. Pakisubukang muli."

#: blueprints/citizen.py:423
msgid "You can only view your own reports."
msgstr "Ang sarili mong mga ulat lamang ang maaari mong tingnan."

#: blueprints/citizen.py:487
msgid "Online SOS is no longer available. Please call an emergency hotline."
msgstr ""
"Hindi na available ang online SOS. Mangyaring tumawag sa emergency "
"hotline."

#: blueprints/commander.py:16 blueprints/commander.py:332
#: blueprints/commander.py:380 blueprints/commander.py:403
#: blueprints/commander.py:426 blueprints/commander.py:447
#: blueprints/commander.py:468 blueprints/commander.py:571
#: blueprints/commander.py:623 blueprints/commander.py:681
msgid "Incident Commander access required."
msgstr "Kailangan ng pahintulot ng incident commander."

#: blueprints/commander.py:75
msgid "A reason is required when modifying or rejecting an AI recommendation."
msgstr "Kailangan ng dahilan sa pagbabago o pagtanggi sa rekomendasyon ng AI."

#: blueprints/commander.py:83
msgid "This incident has no AI recommendation to decide on."
msgstr "Walang rekomendasyon ng AI sa insidenteng ito na kailangang pagpasyahan."

#: blueprints/commander.py:117
msgid "Unable to record the recommendation decision. Please try again."
msgstr "Hindi maitala ang pasya sa rekomendasyon. Pakisubukang muli."

#: blueprints/commander.py:119
msgid "AI recommendation rejected; no incident response was activated."
msgstr ""
"Tinanggihan ang rekomendasyon ng AI; walang tugon sa insidente ang na-"
"activate."

#: blueprints/commander.py:147
msgid "Unable to create the incident response. Please try again."
msgstr "Hindi magawa ang tugon sa insidente. Pakisubukang muli."

#: blueprints/commander.py:150
#, python-format
msgid "Incident response activated for incident %(incident_id)s."
msgstr "Na-activate ang tugon para sa insidente %(incident_id)s."

#: blueprints/commander.py:166 blueprints/eoc.py:276
msgid "A reason is required to mark an incident as a false alarm."
msgstr "Kailangan ng dahilan upang markahan ang insidente bilang maling alarma."

#: blueprints/commander.py:196 blueprints/eoc.py:306
msgid "Unable to mark the incident as rejected. Please try again."
msgstr "Hindi mamarkahan ang insidente bilang tinanggihan. Pakisubukang muli."

#: blueprints/commander.py:199 blueprints/eoc.py:309
msgid "Incident marked as rejected false alarm."
msgstr "Minarkahan ang insidente bilang tinanggihang maling alarma."

#: blueprints/commander.py:303
msgid "Response rating must be between 1 and 5."
msgstr "Dapat nasa pagitan ng 1 at 5 ang rating ng tugon."

#: blueprints/commander.py:315
msgid "Unable to save the evaluation. Please try again."
msgstr "Hindi ma-save ang pagsusuri. Pakisubukang muli."

#: blueprints/commander.py:318
msgid "Post-incident evaluation saved."
msgstr "Na-save na ang pagsusuri pagkatapos ng insidente."

#: blueprints/commander.py:325
msgid "Please select an incident response from the Command Center."
msgstr "Pumili ng tugon sa insidente mula sa Command Center."

#: blueprints/commander.py:341 blueprints/commander.py:388
#: blueprints/commander.py:411 blueprints/commander.py:434
#: blueprints/commander.py:455
msgid ""
"The incident linked to this response could not be found. It may have been"
" deleted."
msgstr ""
"Hindi makita ang insidenteng kaugnay ng tugon na ito. Maaaring nabura na "
"ito."

#: blueprints/commander.py:517
msgid "Unable to close the incident response. Please try again."
msgstr "Hindi maisara ang tugon sa insidente. Pakisubukang muli."

#: blueprints/commander.py:520
msgid "Incident response closed successfully and incident marked resolved."
msgstr "Matagumpay na naisara ang tugon at minarkahang nalutas ang insidente."

#: blueprints/commander.py:538
msgid "Only closed incident responses can be reopened."
msgstr "Mga naisara lamang na tugon sa insidente ang maaaring buksan muli."

#: blueprints/commander.py:561
msgid "Unable to reopen the incident response. Please try again."
msgstr "Hindi mabuksan muli ang tugon sa insidente. Pakisubukang muli."

#: blueprints/commander.py:564
#, python-format
msgid "Incident response #%(incident_id)s reopened."
msgstr "Muling binuksan ang tugon sa insidente #%(incident_id)s."

#: blueprints/commander.py:611 blueprints/commander.py:658
#: blueprints/commander.py:798 blueprints/commander.py:833
#: blueprints/commander.py:870
msgid "Unable to complete the commander operation. Please try again."
msgstr "Hindi makumpleto ang operasyon ng commander. Pakisubukang muli."

#: blueprints/commander.py:614
#, python-format
msgid "Task \"%(title)s\" assigned to %(agency)s."
msgstr "Itinalaga sa %(agency)s ang task na \"%(title)s\"."

#: blueprints/commander.py:639 blueprints/coordinator.py:227
msgid "Quantity must be at least 1."
msgstr "Dapat hindi bababa sa 1 ang dami."

#: blueprints/commander.py:661
#, python-format
msgid "Resource allocated: %(quantity)s x %(resource_type)s from %(agency)s."
msgstr "Inilaan ang %(quantity)s x %(resource_type)s mula sa %(agency)s."

#: blueprints/commander.py:693
msgid "Enter a number of people greater than zero."
msgstr "Maglagay ng bilang ng tao na higit sa zero."

#: blueprints/commander.py:699
#, python-format
msgid ""
"\"%(center)s\" only has room for %(remaining)s more people (capacity "
"%(capacity)s). Choose another center or reduce the count."
msgstr ""
"May puwang lamang para sa %(remaining)s pang tao ang \"%(center)s\" "
"(kapasidad: %(capacity)s). Pumili ng ibang sentro o bawasan ang bilang."

#: blueprints/commander.py:701
msgid "That center"
msgstr "Ang sentrong iyon"

#: blueprints/commander.py:735 blueprints/facilities.py:183
msgid "This evacuation center was updated by another user. Reload and try again."
msgstr ""
"Na-update ng ibang user ang evacuation center na ito. I-reload at "
"subukang muli."

#: blueprints/commander.py:740
msgid "Unable to record the evacuation. Please try again."
msgstr "Hindi maitala ang paglikas. Pakisubukang muli."

#: blueprints/commander.py:743
#, python-format
msgid "Recorded %(people_count)s people evacuated to %(center)s."
msgstr "Naitala ang paglikas ng %(people_count)s tao papunta sa %(center)s."

#: blueprints/commander.py:745
msgid "the center"
msgstr "sentro"

#: blueprints/commander.py:761
msgid ""
"Only Incident Commanders can create situation reports. Coordinators use "
"their Coordinator portal to submit reports."
msgstr ""
"Incident commander lamang ang maaaring gumawa ng situation report. Sa "
"Coordinator portal nagsusumite ng ulat ang mga coordinator."

#: blueprints/commander.py:767
msgid "You can only create situation reports for incidents you command."
msgstr ""
"Maaari ka lamang gumawa ng situation report para sa mga insidenteng ikaw "
"ang namumuno."

#: blueprints/commander.py:801
#, python-format
msgid "Situation report \"%(title)s\" created successfully."
msgstr "Matagumpay na nagawa ang situation report na \"%(title)s\"."

#: blueprints/commander.py:828 blueprints/coordinator.py:286
msgid "This resource was updated by another user. Reload and try again."
msgstr "Na-update ng ibang user ang resource na ito. I-reload at subukang muli."

#: blueprints/commander.py:836
#, python-format
msgid "Task status updated to %(status)s."
msgstr "Na-update ang status ng task sa %(status)s."

#: blueprints/commander.py:865 blueprints/coordinator.py:123
#: blueprints/responder.py:282
msgid "This task was updated by another user. Reload and try again."
msgstr "Na-update ng ibang user ang task na ito. I-reload at subukang muli."

#: blueprints/commander.py:873 blueprints/coordinator.py:293
#, python-format
msgid "Resource status updated to %(status)s."
msgstr "Na-update ang status ng resource sa %(status)s."

#: blueprints/coordinator.py:35 blueprints/coordinator.py:81
#: blueprints/coordinator.py:103 blueprints/coordinator.py:141
#: blueprints/coordinator.py:175 blueprints/coordinator.py:207
#: blueprints/coordinator.py:266 blueprints/coordinator.py:304
#: blueprints/coordinator.py:326 blueprints/coordinator.py:389
#: blueprints/coordinator.py:411 blueprints/coordinator.py:416
#: blueprints/coordinator.py:442 blueprints/coordinator.py:464
msgid "Access denied."
msgstr "Walang pahintulot."

#: blueprints/coordinator.py:109
msgid "You can only update tasks assigned to your agency."
msgstr "Maaari mo lamang i-update ang mga task na nakatalaga sa iyong ahensya."

#: blueprints/coordinator.py:128 blueprints/coordinator.py:291
#: blueprints/coordinator.py:376 blueprints/coordinator.py:504
msgid "Unable to complete the coordinator operation. Please try again."
msgstr "Hindi makumpleto ang operasyon ng coordinator. Pakisubukang muli."

#: blueprints/coordinator.py:130
#, python-format
msgid "Task \"%(title)s\" updated to %(status)s."
msgstr "Na-update ang task na \"%(title)s\" sa status na %(status)s."

#: blueprints/coordinator.py:219 blueprints/coordinator.py:347
#: blueprints/coordinator.py:469
msgid "Coordinator agency is not configured."
msgstr "Hindi naka-configure ang ahensya ng coordinator."

#: blueprints/coordinator.py:223 blueprints/coordinator.py:338
msgid "Please fill in all required fields."
msgstr "Punan ang lahat ng kinakailangang field."

#: blueprints/coordinator.py:233
msgid "You can only allocate resources to responses that include your agency."
msgstr ""
"Maaari ka lamang maglaan ng resource sa mga tugong kinabibilangan ng "
"iyong ahensya."

#: blueprints/coordinator.py:252
msgid "Unable to allocate the resource. Please try again."
msgstr "Hindi mailaan ang resource. Pakisubukang muli."

#: blueprints/coordinator.py:254
#, python-format
msgid ""
"%(quantity)s x %(resource_type)s (%(agency)s) allocated to Response "
"#%(incident_id)s."
msgstr ""
"Inilaan ang %(quantity)s x %(resource_type)s (%(agency)s) sa Tugon "
"#%(incident_id)s."

#: blueprints/coordinator.py:272
msgid "You can only update resources allocated to your agency."
msgstr "Maaari mo lamang i-update ang mga resource na inilaan sa iyong ahensya."

#: blueprints/coordinator.py:356
msgid "You can only submit reports for responses that include your agency."
msgstr ""
"Maaari ka lamang magsumite ng ulat para sa mga tugong kinabibilangan ng "
"iyong ahensya."

#: blueprints/coordinator.py:378
#, python-format
msgid "Broadcast message \"%(title)s\" submitted successfully."
msgstr "Matagumpay na naipadala ang broadcast na \"%(title)s\"."

#: blueprints/coordinator.py:477
msgid "Incident, resource type, and a valid quantity are required."
msgstr "Kailangan ang insidente, uri ng resource, at wastong dami."

#: blueprints/coordinator.py:507
#, python-format
msgid "Resource request for %(quantity)s x %(resource_type)s submitted."
msgstr "Naipadala ang kahilingan para sa %(quantity)s x %(resource_type)s."

#: blueprints/eoc.py:16 blueprints/eoc.py:93 blueprints/eoc.py:156
#: blueprints/eoc.py:652
msgid "EOC Staff access required."
msgstr "Kailangan ng pahintulot ng kawani ng EOC."

#: blueprints/eoc.py:222 blueprints/eoc.py:256 blueprints/eoc.py:519
#: blueprints/eoc.py:609 blueprints/eoc.py:638 blueprints/eoc.py:705
msgid "Unable to complete the EOC operation. Please try again."
msgstr "Hindi makumpleto ang operasyon ng EOC. Pakisubukang muli."

#: blueprints/eoc.py:224
msgid "Alert status updated."
msgstr "Na-update ang status ng alerto."

#: blueprints/eoc.py:259
msgid "Incident marked as verified."
msgstr "Minarkahan bilang beripikado ang insidente."

#: blueprints/eoc.py:324
msgid "An incident response already exists for this incident."
msgstr "May umiiral nang tugon para sa insidenteng ito."

#: blueprints/eoc.py:329 blueprints/eoc.py:383
msgid "Please select a commander."
msgstr "Pumili ng commander."

#: blueprints/eoc.py:334 blueprints/eoc.py:388
msgid "Invalid commander selected."
msgstr "Di-wasto ang napiling commander."

#: blueprints/eoc.py:362
msgid "Unable to assign the commander. Please try again."
msgstr "Hindi maitalaga ang commander. Pakisubukang muli."

#: blueprints/eoc.py:365
#, python-format
msgid "Commander \"%(name)s\" assigned to incident #%(incident_id)s."
msgstr "Itinalaga si commander \"%(name)s\" sa insidente #%(incident_id)s."

#: blueprints/eoc.py:410
msgid "Unable to transfer the commander. Please try again."
msgstr "Hindi mailipat ang commander. Pakisubukang muli."

#: blueprints/eoc.py:413
#, python-format
msgid ""
"Response #%(response_id)s transferred from %(old_commander)s to "
"%(new_commander)s."
msgstr ""
"Inilipat ang Tugon #%(response_id)s mula kay %(old_commander)s kay "
"%(new_commander)s."

#: blueprints/eoc.py:425
msgid "You do not have permission to review resource requests."
msgstr "Wala kang pahintulot na suriin ang mga kahilingan sa resource."

#: blueprints/eoc.py:452
msgid "You do not have permission to decide resource requests."
msgstr "Wala kang pahintulot na magpasya sa mga kahilingan sa resource."

#: blueprints/eoc.py:464
msgid "Invalid decision."
msgstr "Di-wasto ang pasya."

#: blueprints/eoc.py:475
msgid ""
"This incident has no active response yet. A commander must activate the "
"response before this request can be fulfilled."
msgstr ""
"Wala pang aktibong tugon ang insidenteng ito. Kailangang i-activate ito "
"ng commander bago matupad ang kahilingan."

#: blueprints/eoc.py:523
#, python-format
msgid ""
"Request #%(request_id)s marked fulfilled — %(quantity)s x "
"%(resource_type)s allocated to response #%(incident_id)s."
msgstr ""
"Minarkahang natupad ang kahilingan #%(request_id)s — inilaan ang "
"%(quantity)s x %(resource_type)s sa Tugon #%(incident_id)s."

#: blueprints/eoc.py:531
#, python-format
msgid "Request #%(request_id)s marked %(decision)s."
msgstr "Minarkahan ang kahilingan #%(request_id)s bilang %(decision)s."

#: blueprints/eoc.py:546
msgid "You do not have permission to view alerts."
msgstr "Wala kang pahintulot na tingnan ang mga alerto."

#: blueprints/eoc.py:572
msgid "You do not have permission to issue alerts."
msgstr "Wala kang pahintulot na maglabas ng mga alerto."

#: blueprints/eoc.py:581
msgid "Alert title and message are required."
msgstr "Kailangan ang pamagat at mensahe ng alerto."

