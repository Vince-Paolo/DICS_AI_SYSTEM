# Core application settings
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///instance/database.db
ADMIN_PASSWORD=change-this-before-startup

# AI decision support
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# External services
OPENWEATHER_API_KEY=
REDIS_URL=
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_SUPPRESS_SEND=false

# OTP delivery can use Resend or Gmail SMTP. For Gmail, enable 2-Step
# Verification and create an App Password; never use your regular password.
OTP_EMAIL_BACKEND=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-account@gmail.com
SMTP_FROM_NAME=DICS AI

# Runtime and security options
MAX_UPLOAD_SIZE_BYTES=16777216
SESSION_COOKIE_SECURE=false
ENABLE_HSTS=false
FLASK_DEBUG=0

# Citizen emergency hotlines (Emergency Assistance page). Use verified official
# numbers from San Pablo City / CDRRMO / EOC. Separate multiple numbers with |.
HOTLINE_GENERAL=911
HOTLINE_CDRRMO=
HOTLINE_CITY_HEALTH=
HOTLINE_CTMO=
HOTLINE_SAN_PABLO_PNP=
HOTLINE_SAN_PABLO_FIRE=
HOTLINE_BARANGAY_RADIO_CONTROL=
HOTLINE_MERALCO=

# The old citizen report form and online SOS button are retired. Set to true
# only to re-enable them for testing.
PUBLIC_REPORTING_ENABLED=false
